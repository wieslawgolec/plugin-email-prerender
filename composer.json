{
    "name": "wieslawgolec/mautic-email-prerender-bundle",
    "description": "A Mautic 7 plugin that pre-compiles and caches email payloads in advance, eliminating runtime rendering overhead during the dispatch event loop.",
    "type": "mautic-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Wiesław Golec",
            "homepage": "https://github.com/wieslawgolec"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "psr/log": "^3.0"
    },
    "extra": {
        "install-directory-name": "MauticEmailPreRenderBundle"
    },
    "autoload": {
        "psr-4": {
            "MauticPlugin\\MauticEmailPreRenderBundle\\": ""
        },
        "exclude-from-classmap": [
            "Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MauticPlugin\\MauticEmailPreRenderBundle\\Tests\\": "Tests/"
        },
        "files": [
            "Tests/bootstrap.php"
        ]
    },
    "scripts": {
        "test": "phpunit"
    }
}
